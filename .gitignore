# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Dependencies (added later if the plugin gains a build step). Both are
# root-anchored on purpose: an unanchored "vendor/" also matches
# lib/plugin-update-checker/vendor/, which is vendored runtime code that must
# ship. It did exactly that once — Parsedown was never committed, so every
# release zip omitted it and the self-updater fataled on merchant sites.
/node_modules/
/vendor/

# Build artifacts / release zips
/dist/
/build/
*.zip

# Local env
.env

# Personal dev notes — not part of the shared repo
/callouts.md
