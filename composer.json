{
    "name": "oysterai/oyster-woocommerce",
    "description": "Development tooling for the Oyster for WooCommerce plugin. Not shipped — the plugin autoloads its own classes and has no runtime dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Oyster\\Woo\\": "includes/",
            "Oyster\\Woo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
